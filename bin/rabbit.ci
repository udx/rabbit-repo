#!/usr/bin/env bash
set -euo pipefail

readonly RABBIT_CI_VERSION="0.1.3"
readonly RESOLUTION_VERSION="rabbit.ci/repo-resolution/v1"
readonly RESOLUTION_RELATIVE_PATH=".rabbit/repo.yaml"

usage() {
  cat <<'EOF'
Usage: rabbit.ci [--json] [--check] [path]

Generate a portable Rabbit CI repository resolution and report the context an
approved integration may safely use. `path` defaults to the current repository.

Options:
  --json   Emit the integration report as JSON.
  --check  Validate an existing .rabbit/repo.yaml without changing it.
  -h, --help
  -v, --version

The command only writes .rabbit/repo.yaml. GitHub discovery is read-only and
runs only when the repository has a GitHub origin and the `gh` CLI can access it.
EOF
}

json_escape() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  value="${value//$'\n'/\\n}"
  value="${value//$'\r'/\\r}"
  value="${value//$'\t'/\\t}"
  printf '%s' "$value"
}

json_string() {
  printf '"%s"' "$(json_escape "$1")"
}

repo_root() {
  local target="$1"
  if [ -d "$target" ]; then
    printf '%s\n' "$(cd "$target" && pwd)"
    return 0
  fi
  printf 'path is not a directory: %s\n' "$target" >&2
  return 1
}

git_value() {
  local root="$1"
  shift
  git -C "$root" "$@" 2>/dev/null || true
}

github_slug_from_remote() {
  local remote="$1"
  local slug=""

  case "$remote" in
    git@github.com:* ) slug="${remote#git@github.com:}" ;;
    ssh://git@github.com/* ) slug="${remote#ssh://git@github.com/}" ;;
    https://github.com/* ) slug="${remote#https://github.com/}" ;;
    http://github.com/* ) slug="${remote#http://github.com/}" ;;
  esac

  slug="${slug%.git}"
  if [[ "$slug" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]]; then
    printf '%s\n' "$slug"
  fi
}

json_field() {
  local json="$1"
  local filter="$2"
  if command -v jq >/dev/null 2>&1; then
    printf '%s' "$json" | jq -r "$filter" 2>/dev/null || true
  fi
}

json_array() {
  local first=1 value
  printf '['
  for value in "$@"; do
    [ "$first" -eq 1 ] || printf ','
    first=0
    json_string "$value"
  done
  printf ']'
}

append_unique() {
  local value="$1"
  shift
  local existing
  for existing in "$@"; do
    [ "$existing" = "$value" ] && return
  done
  printf '%s\n' "$value"
}

workflow_json() {
  local file="$1"
  local path="$2"
  ruby -rjson -ryaml - "$file" "$path" <<'RUBY'
file, path = ARGV
document = YAML.load_file(file) || {}
triggers = document['on'] || document[true] || {}

def without_descriptions(value)
  case value
  when Hash
    value.each_with_object({}) do |(key, child), result|
      next if key.to_s == 'description'
      result[key.to_s] = without_descriptions(child)
    end
  when Array
    value.map { |child| without_descriptions(child) }
  else
    value
  end
end

normalized_triggers = case triggers
when String
  { triggers => {} }
when Array
  triggers.each_with_object({}) { |trigger, result| result[trigger.to_s] = {} }
when Hash
  triggers.each_with_object({}) do |(trigger, config), result|
    result[trigger.to_s] = config.nil? ? {} : without_descriptions(config)
  end
else
  {}
end

result = { 'path' => path, 'triggers' => normalized_triggers }
result['permissions'] = without_descriptions(document['permissions']) if document.key?('permissions')
puts JSON.generate(result)
RUBY
}

document_json_to_yaml() {
  ruby -rjson -ryaml -e 'print YAML.dump(JSON.parse(STDIN.read)).sub(/\A---\n/, "")'
}

document_yaml_to_json() {
  ruby -rjson -ryaml -e 'puts JSON.generate(YAML.load_file(ARGV.fetch(0)))' "$1"
}

json_collection() {
  if [ "$#" -eq 0 ]; then
    printf '[]'
  else
    printf '%s\n' "$@" | jq -sc '.'
  fi
}

resolution_value() {
  local file="$1"
  local section="$2"
  local key="$3"
  awk -v section="$section" -v key="$key" '
    $0 == section ":" { inside = 1; next }
    inside && /^[^[:space:]#]/ { exit }
    inside && $0 ~ "^  " key ":[[:space:]]*" {
      sub("^  " key ":[[:space:]]*", "")
      quote = sprintf("%c", 39)
      if (substr($0, 1, 1) == quote) {
        sub("^" quote, "")
        sub(quote "$", "")
      }
      print
      exit
    }
  ' "$file"
}

validate_resolution() {
  local file="$1"
  local kind version name
  [ -f "$file" ] || { printf 'missing repository resolution: %s\n' "$file" >&2; return 1; }

  kind="$(awk '
    /^kind:[[:space:]]*/ {
      sub(/^kind:[[:space:]]*/, "")
      print
      exit
    }
  ' "$file")"
  version="$(awk '
    /^version:[[:space:]]*/ {
      sub(/^version:[[:space:]]*/, "")
      quote = sprintf("%c", 39)
      if (substr($0, 1, 1) == quote) {
        sub("^" quote, "")
        sub(quote "$", "")
      }
      print
      exit
    }
  ' "$file")"
  name="$(resolution_value "$file" repository name)"

  [ "$kind" = "repoResolution" ] || { printf 'invalid repository resolution: kind must be repoResolution\n' >&2; return 1; }
  [ "$version" = "$RESOLUTION_VERSION" ] || { printf 'invalid repository resolution version: expected %s\n' "$RESOLUTION_VERSION" >&2; return 1; }
  [ -n "$name" ] || { printf 'invalid repository resolution: repository.name is required\n' >&2; return 1; }
  grep -Eq '^branches:($| \[\])' "$file" || { printf 'invalid repository resolution: branches is required\n' >&2; return 1; }
  grep -Eq '^environments:($| \[\])' "$file" || { printf 'invalid repository resolution: environments is required\n' >&2; return 1; }
  grep -Eq '^workflows:($| \[\])' "$file" || { printf 'invalid repository resolution: workflows is required\n' >&2; return 1; }
}

root="$(repo_root ".")"
format="text"
mode="write"

while [ "$#" -gt 0 ]; do
  case "$1" in
    --json) format="json" ;;
    --check) mode="check" ;;
    -h|--help) usage; exit 0 ;;
    -v|--version) printf '%s\n' "$RABBIT_CI_VERSION"; exit 0 ;;
    --*) printf 'unknown option: %s\n' "$1" >&2; usage >&2; exit 1 ;;
    *) root="$(repo_root "$1")" ;;
  esac
  shift
done

resolution_path="$root/$RESOLUTION_RELATIVE_PATH"
repo_name="$(basename "$root")"
remote="$(git_value "$root" config --get remote.origin.url)"
github_slug="$(github_slug_from_remote "$remote")"
owner=""
if [ -n "$github_slug" ]; then
  owner="${github_slug%%/*}"
fi
default_branch="$(git_value "$root" symbolic-ref --short refs/remotes/origin/HEAD)"
default_branch="${default_branch#origin/}"
[ -n "$default_branch" ] || default_branch="$(git_value "$root" branch --show-current)"
[ -n "$default_branch" ] || default_branch="unknown"

github_status="not_configured"
github_reason="No GitHub origin is configured."
github_default_branch=""
github_permissions='{}'
if [ -n "$github_slug" ]; then
  if ! command -v gh >/dev/null 2>&1; then
    github_status="unavailable"
    github_reason="The gh CLI is unavailable."
  else
    github_response=""
    if github_response="$(gh api -X GET "repos/$github_slug" 2>&1)"; then
      github_status="available"
      github_reason="Repository metadata is available through the current gh token."
      github_default_branch="$(json_field "$github_response" '.default_branch // empty')"
      github_permissions="$(printf '%s' "$github_response" | jq -c '.permissions // {}' 2>/dev/null || printf '{}')"
      [ -n "$github_default_branch" ] && default_branch="$github_default_branch"
    elif [[ "$github_response" == *"HTTP 401"* || "$github_response" == *"authentication required"* ]]; then
      github_status="unauthenticated"
      github_reason="The current gh token cannot authenticate this request."
    elif [[ "$github_response" == *"HTTP 403"* ]]; then
      github_status="forbidden"
      github_reason="The current gh token cannot read this repository."
    elif [[ "$github_response" == *"HTTP 404"* || "$github_response" == *"Not Found"* ]]; then
      github_status="not_accessible"
      github_reason="The repository is absent or not visible to the current gh token."
    else
      github_status="unavailable"
      github_reason="GitHub metadata could not be resolved."
    fi
  fi
fi

if [ "$mode" = "check" ]; then
  validate_resolution "$resolution_path"
  resolution_document="$(document_yaml_to_json "$resolution_path")"
else
  branches=()
  protected_branches=()
  if [ "$github_status" = "available" ]; then
    github_branches_response="$(gh api -X GET "repos/$github_slug/branches?per_page=100" 2>/dev/null || true)"
    while IFS=$'\t' read -r branch protected; do
      [ -n "$branch" ] || continue
      candidate="$(append_unique "$branch" "${branches[@]}")"
      [ "$candidate" = "$branch" ] && branches+=("$branch")
      [ "$protected" = "true" ] && protected_branches+=("$branch")
    done < <(printf '%s' "$github_branches_response" | jq -r '.[]? | "\(.name)\t\(.protected)"' 2>/dev/null || true)
  fi
  if [ "${#branches[@]}" -eq 0 ]; then
    while IFS= read -r branch; do
      branch="${branch#origin/}"
      [ "$branch" = "HEAD" ] && continue
      [ -n "$branch" ] || continue
      candidate="$(append_unique "$branch" "${branches[@]}")"
      [ "$candidate" = "$branch" ] && branches+=("$branch")
    done < <(git_value "$root" for-each-ref refs/remotes/origin --format='%(refname:short)')
  fi
  if [ "${#branches[@]}" -eq 0 ] && [ -n "$default_branch" ] && [ "$default_branch" != "unknown" ]; then
    branches+=("$default_branch")
  fi

  branch_items=()
  for branch in "${branches[@]}"; do
    rules_response='[]'
    if [ "$github_status" = "available" ]; then
      rules_response="$(gh api -X GET "repos/$github_slug/rules/branches/$branch" 2>/dev/null || printf '[]')"
    fi
    rules_json="$(printf '%s' "$rules_response" | jq -c '
      if type != "array" then {} else
        reduce .[] as $rule ({};
          if $rule.type == "deletion" then .allow_deletions = false
          elif $rule.type == "non_fast_forward" then .allow_force_pushes = false
          elif $rule.type == "pull_request" then .pull_request = {
            approvals: ($rule.parameters.required_approving_review_count // 0),
            code_owner_review: ($rule.parameters.require_code_owner_review // false),
            stale_reviews: ($rule.parameters.dismiss_stale_reviews_on_push // false),
            last_push_approval: ($rule.parameters.require_last_push_approval // false),
            conversation_resolution: ($rule.parameters.required_review_thread_resolution // false),
            merge_methods: ($rule.parameters.allowed_merge_methods // [])
          }
          elif $rule.type == "copilot_code_review" then .copilot_review = {
            on_push: ($rule.parameters.review_on_push // false),
            drafts: ($rule.parameters.review_draft_pull_requests // false)
          }
          else . end
        )
      end
    ' 2>/dev/null || printf '{}')"
    branch_items+=("$(jq -cn --arg name "$branch" --argjson rules "$rules_json" '{name:$name,rules:$rules}')")
  done
  branches_json="$(json_collection "${branch_items[@]}")"

  environment_items=()
  environment_names=()
  if [ "$github_status" = "available" ]; then
    github_environments_response="$(gh api -X GET "repos/$github_slug/environments?per_page=100" 2>/dev/null || true)"
    while IFS= read -r environment; do
      [ -n "$environment" ] && environment_names+=("$environment")
    done < <(printf '%s' "$github_environments_response" | jq -r '.environments[]?.name // empty' 2>/dev/null || true)
  fi
  for environment in "${environment_names[@]}"; do
    environment_response="$(gh api -X GET "repos/$github_slug/environments/$environment" 2>/dev/null || printf '{}')"
    environment_branches='["*"]'
    custom_branch_policies="$(printf '%s' "$environment_response" | jq -r '.deployment_branch_policy.custom_branch_policies // false' 2>/dev/null || printf 'false')"
    protected_branch_policy="$(printf '%s' "$environment_response" | jq -r '.deployment_branch_policy.protected_branches // false' 2>/dev/null || printf 'false')"
    if [ "$custom_branch_policies" = "true" ]; then
      policies_response="$(gh api -X GET "repos/$github_slug/environments/$environment/deployment-branch-policies" 2>/dev/null || printf '{}')"
      environment_branches="$(printf '%s' "$policies_response" | jq -c '[.branch_policies[]?.name] // []' 2>/dev/null || printf '[]')"
    elif [ "$protected_branch_policy" = "true" ]; then
      environment_branches="$(json_array "${protected_branches[@]}")"
    fi
    approvals="$(printf '%s' "$environment_response" | jq -c '[.protection_rules[]? | select(.type == "required_reviewers") | (.reviewers // [])[] | {type:(.type // .reviewer.type // "user"), id:(.reviewer.id // .id)}] | map(select(.id != null))' 2>/dev/null || printf '[]')"
    wait_minutes="$(printf '%s' "$environment_response" | jq -r '[.protection_rules[]? | select(.type == "wait_timer") | (.wait_timer // .wait_timer_minutes // 0)] | first // 0' 2>/dev/null || printf '0')"
    admin_bypass="$(printf '%s' "$environment_response" | jq -r '.can_admins_bypass // false' 2>/dev/null || printf 'false')"
    secrets_response="$(gh api -X GET "repos/$github_slug/environments/$environment/secrets" 2>/dev/null || printf '{}')"
    variables_response="$(gh api -X GET "repos/$github_slug/environments/$environment/variables" 2>/dev/null || printf '{}')"
    secrets="$(printf '%s' "$secrets_response" | jq -c '[.secrets[]?.name] // []' 2>/dev/null || printf '[]')"
    variables="$(printf '%s' "$variables_response" | jq -c '[.variables[]?.name] // []' 2>/dev/null || printf '[]')"
    environment_items+=("$(jq -cn --arg name "$environment" --argjson branches "$environment_branches" --argjson approvals "$approvals" --argjson wait_minutes "$wait_minutes" --argjson admin_bypass "$admin_bypass" --argjson secrets "$secrets" --argjson variables "$variables" '{name:$name,branches:$branches,approvals:$approvals,wait_minutes:$wait_minutes,admin_bypass:$admin_bypass,secrets:$secrets,variables:$variables}')")
  done
  environments_json="$(json_collection "${environment_items[@]}")"

  workflow_items=()
  if [ -d "$root/.github/workflows" ]; then
    while IFS= read -r workflow; do
      workflow_items+=("$(workflow_json "$workflow" "${workflow#"$root/"}")")
    done < <(find "$root/.github/workflows" -type f \( -name '*.yml' -o -name '*.yaml' \) -print | sort)
  fi
  workflows_json="$(json_collection "${workflow_items[@]}")"

  repository_json="$(jq -cn --arg name "$repo_name" --arg owner "$owner" --arg default_branch "$default_branch" 'if $owner == "" then {name:$name,default_branch:$default_branch} else {name:$name,owner:$owner,default_branch:$default_branch} end')"
  resolution_document="$(jq -cn --arg kind "repoResolution" --arg version "$RESOLUTION_VERSION" --argjson repository "$repository_json" --argjson branches "$branches_json" --argjson environments "$environments_json" --argjson workflows "$workflows_json" '{kind:$kind,version:$version,repository:$repository,branches:$branches,environments:$environments,workflows:$workflows}')"

  mkdir -p "$(dirname "$resolution_path")"
  tmp_resolution="$(mktemp "${resolution_path}.tmp.XXXXXX")"
  trap 'rm -f "$tmp_resolution"' EXIT
  printf '%s' "$resolution_document" | document_json_to_yaml > "$tmp_resolution"
  mv "$tmp_resolution" "$resolution_path"
  trap - EXIT
fi

if [ "$format" = "json" ]; then
  printf '%s\n' "$resolution_document"
  exit 0
fi

printf 'rabbit.ci\n'
printf '  resolution: %s (%s)\n' "$RESOLUTION_RELATIVE_PATH" "$mode"
printf '  repository: %s\n' "$repo_name"
printf '  branches: %s\n' "$(printf '%s' "$resolution_document" | jq -r '.branches | length')"
printf '  environments: %s\n' "$(printf '%s' "$resolution_document" | jq -r '.environments | length')"
printf '  workflows: %s\n' "$(printf '%s' "$resolution_document" | jq -r '.workflows | length')"
